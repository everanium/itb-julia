#!/usr/bin/env bash
#
# eitb -- launcher for the Julia binding's CLI demonstrator. Resolves
# the binding's project directory relative to this script so the CLI
# runs from any working directory.

set -eu

DIR="$(cd "$(dirname "$0")" && pwd)"
exec julia --startup-file=no --project="$DIR/.." "$DIR/itb_eitb.jl" "$@"
